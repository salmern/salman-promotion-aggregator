# ─── Database ────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=promotions
MYSQL_USER=promotions_user
MYSQL_PASSWORD=promotions_pass
DATABASE_URL=mysql://promotions_user:promotions_pass@mysql:3306/promotions

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── API ─────────────────────────────────────────────────────────────────────
API_PORT=3000
NODE_ENV=development

# ─── Frontend ────────────────────────────────────────────────────────────────
# Points to the API from the browser (client-side) — use localhost in dev
NEXT_PUBLIC_API_URL=http://localhost:3000

# ─── Scraper ─────────────────────────────────────────────────────────────────
SOURCE_PORTAL_URL=https://www.thepromenadeshopsatbriargate.com
SCRAPER_REQUEST_DELAY_MS=1500
SCRAPER_MAX_CONCURRENCY=2
